{
  "name": "cosplay-booth-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "check:offline": "node scripts/check-offline-assets.mjs",
    "android:sync": "npm run build && npm run check:offline && cap sync android",
    "android:apk": "npm run android:sync && node scripts/gradle-assemble.mjs",
    "android:release": "npm run android:sync && node scripts/gradle-assemble.mjs assembleRelease",
    "android:bundle": "npm run android:sync && node scripts/gradle-assemble.mjs bundleRelease",
    "android:key": "node scripts/create-release-keystore.mjs",
    "android:open": "cap open android",
    "build:e2e": "tsc -b && vite build --config vite.e2e.config.ts",
    "android:e2e": "npm run build:e2e && node scripts/device-e2e.mjs --build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/fredoka": "^5.2.6",
    "@fontsource/nunito": "^5.2.6",
    "@fontsource/pixelify-sans": "^5.3.0",
    "dexie": "^4.4.6",
    "lucide-react": "^0.468.0",
    "motion": "^14.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "playwright-core": "^1.64.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
